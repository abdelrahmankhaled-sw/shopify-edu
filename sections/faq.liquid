{% comment %}
  FAQ Section - Reusable CMS blocks
  Allows heading input and multiple FAQ blocks (question/answer)
  Implements expand/collapse for each block
{% endcomment %}

<section class="faq-section">
  <div class="faq-container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item" data-faq-index="{{ forloop.index0 }}">
          <button class="faq-question" type="button" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}">
            {{ block.settings.question }}
            <span class="faq-toggle-icon" aria-hidden="true">&#9660;</span>
          </button>
          <div class="faq-answer" id="faq-answer-{{ block.id }}" hidden>
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.faq-section {
  background: #f6f9fb;
  border-radius: 20px;
  padding: 2rem;
  margin: 2rem 0;
}
.faq-container h2 {
  font-size: 2rem;
  margin-bottom: 1.5rem;
}
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.faq-item {
  border: 2px dashed #bcd2e6;
  border-radius: 8px;
  background: #fff;
}
.faq-question {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  font-size: 1.1rem;
  padding: 1rem;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.faq-toggle-icon {
  font-size: 1.2rem;
  transition: transform 0.2s;
}
.faq-question[aria-expanded="true"] .faq-toggle-icon {
  transform: rotate(180deg);
}
.faq-answer {
  padding: 1rem;
  border-top: 1px solid #e3e8ee;
  font-size: 1rem;
  color: #444;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.faq-question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !expanded);
      const answer = btn.parentElement.querySelector('.faq-answer');
      if (answer) {
        answer.hidden = expanded;
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently asked questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_block",
      "name": "FAQ Block",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "category": "Text",
      "blocks": [
        {
          "type": "faq_block",
          "settings": {
            "question": "Frequently asked question",
            "answer": "Use this text to answer questions in as much detail as possible for your customers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
